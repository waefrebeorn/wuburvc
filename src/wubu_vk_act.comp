#version 450
layout(local_size_x = 256) in;

layout(set = 0, binding = 0) buffer XBuf { float x_f[]; };
layout(set = 0, binding = 1) buffer OBuf { float o_f[]; };  /* per-channel offsets (bias/cond) */

/* mode: 0 = lrelu(x, 0.1); 1 = snake(x); 2 = tanh; 3 = add o; 4 = copy o->x? (no)
 * mode 3: x += o[channel]  (per-channel offset — cond/bias)
 * mode 4: x *= scalar in push[1] */
layout(push_constant) uniform PC {
    int mode;
    int n_ch;      /* channels (mode 3: x is [n_ch * n], offset per channel) */
    int n;         /* samples per channel */
    float scalar;  /* mode 4 scale */
} pc;

void main() {
    uint i = gl_GlobalInvocationID.x;
    if (i >= uint(pc.n_ch) * uint(pc.n)) return;
    if (pc.mode == 0) {
        float v = x_f[i];
        x_f[i] = v > 0.0 ? v : v * 0.1;
    } else if (pc.mode == 1) {
        float v = x_f[i];
        float a = 1.0;
        float s = sin(a * v);
        x_f[i] = v + (1.0 / max(a * 2.0, 1e-6)) * s * s;
    } else if (pc.mode == 2) {
        x_f[i] = tanh(x_f[i]);
    } else if (pc.mode == 3) {
        uint ch = i / uint(pc.n);
        x_f[i] += o_f[ch];
    } else if (pc.mode == 4) {
        x_f[i] *= pc.scalar;
    }
}
