#version 450
layout(local_size_x = 256) in;

layout(set = 0, binding = 0) buffer ABuf { float a_f[]; };
layout(set = 0, binding = 1) buffer BBuf { float b_f[]; };

/* mode: 0 = a += b; 1 = a = b (copy) */
layout(push_constant) uniform PC {
    int mode;
    int n;
} pc;

void main() {
    uint i = gl_GlobalInvocationID.x;
    if (i >= uint(pc.n)) return;
    if (pc.mode == 0) a_f[i] += b_f[i];
    else a_f[i] = b_f[i];
}
